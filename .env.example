# N3Fit UI — Environment Variables
# Copy this file to .env and fill in values.
#   cp .env.example .env

# ── API Base URL ────────────────────────────────────────────────────────
# Points to the backend. No trailing slash.
# In development, set proxy in package.json instead OR set this directly.
REACT_APP_API_BASE_URL=http://localhost:5000/api/v1

# ── Backend URL (for Axios baseURL) ────────────────────────────────────
# Used by src/shared/services/api.js
REACT_APP_BACKEND_URL=http://localhost:5000/api/v1
